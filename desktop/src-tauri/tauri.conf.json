{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFTPUpdater-AI",
  "mainBinaryName": "OpenFTPUpdater-AI",
  "version": "0.1.2",
  "identifier": "io.github.bl0rb.openftpupdater",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenFTPUpdater-AI",
        "width": 1080,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "© 2026 bl0rb · MIT License · github.com/bl0rb/OpenFTPUpdater-AI",
    "shortDescription": "Update a static website with Claude Code and publish it via SFTP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": null
    }
  }
}
